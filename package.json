{
  "name": "@t3tools/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "https://pkg.pr.new/Effect-TS/effect-smol/effect@8881a9b",
      "@effect/platform-node": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node@8881a9b",
      "@effect/openapi-generator": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/openapi-generator@8881a9b",
      "@effect/sql-sqlite-bun": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/sql-sqlite-bun@8881a9b",
      "@effect/vitest": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/vitest@8881a9b",
      "@effect/language-service": "0.75.1",
      "@types/bun": "^1.3.9",
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "^4.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-dependencies.ts --install && node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/check-dependencies.ts --install && node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/check-dependencies.ts --install && node scripts/dev-runner.ts dev:web",
    "dev:marketing": "node node_modules/turbo/bin/turbo run dev --env-mode=loose --filter=@t3tools/marketing",
    "dev:desktop": "node scripts/check-dependencies.ts --install && node scripts/dev-runner.ts dev:desktop",
    "start": "node node_modules/turbo/bin/turbo run start --env-mode=loose --filter=t3",
    "start:desktop": "bun run build:desktop && node node_modules/turbo/bin/turbo run start --env-mode=loose --filter=@t3tools/desktop",
    "start:marketing": "node node_modules/turbo/bin/turbo run preview --env-mode=loose --filter=@t3tools/marketing",
    "build": "node node_modules/turbo/bin/turbo run build",
    "build:marketing": "node node_modules/turbo/bin/turbo run build --filter=@t3tools/marketing",
    "build:desktop": "node scripts/check-dependencies.ts --install && node node_modules/turbo/bin/turbo run build --filter=@t3tools/desktop --filter=t3",
    "check:dependencies": "node scripts/check-dependencies.ts",
    "postinstall": "node scripts/check-dependencies.ts --record-install",
    "repair:stuck-turns": "bun apps/server/scripts/repair-stuck-turns.ts",
    "typecheck": "node node_modules/turbo/bin/turbo run typecheck",
    "lint": "node node_modules/oxlint/bin/oxlint --report-unused-disable-directives",
    "test": "node node_modules/turbo/bin/turbo run test --concurrency=2 --continue=always",
    "test:full": "node scripts/run-test-stages.ts test test:server:git:extended",
    "test:bun-server-boot": "node scripts/bun-server-boot-smoke.ts",
    "computer:certify": "bun scripts/computer-certification.ts",
    "test:server:unit": "bun run --cwd apps/server test:unit",
    "test:server:git": "bun run --cwd apps/server test:git",
    "test:server:git:smoke": "bun run --cwd apps/server test:git:smoke",
    "test:server:git:extended": "bun run --cwd apps/server test:git:extended",
    "protocol:audit": "bun scripts/audit-codex-protocol.ts",
    "protocol:audit:baseline": "bun scripts/audit-codex-protocol.ts --install-baseline",
    "protocol:audit:muse": "bun scripts/audit-muse-protocol.ts",
    "upstream-ports:check": "bun scripts/check-upstream-ports.ts",
    "test:server:integration": "bun run --cwd apps/server test:integration",
    "test:server:shard": "bun run --cwd apps/server test:unit:shard",
    "test:profiles-smoke": "bun run build:desktop && node scripts/profile-lifecycle-smoke.cjs",
    "test:desktop-smoke": "node node_modules/turbo/bin/turbo run smoke-test --filter=@t3tools/desktop",
    "fmt": "node node_modules/oxfmt/bin/oxfmt",
    "fmt:check": "node node_modules/oxfmt/bin/oxfmt --check",
    "build:contracts": "node node_modules/turbo/bin/turbo run build --filter=@t3tools/contracts",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "clean": "node scripts/clean.ts",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs",
    "perf:server": "bun scripts/performance.ts",
    "perf:interactive": "bun scripts/performance.ts interactive",
    "perf:compare": "bun scripts/performance.ts compare",
    "screenshots:capture": "bun scripts/capture-screenshots.ts",
    "dist:cli:archive": "node scripts/build-cli-archive.ts",
    "dist:cli:manifest": "node scripts/merge-cli-release-manifests.ts",
    "test:cli-smoke": "node scripts/cli-archive-smoke.ts",
    "sdk:audit": "bun scripts/audit-claude-sdk.ts",
    "protocol:audit:requests": "bun scripts/audit-codex-request-shapes.ts",
    "protocol:audit:requests:baseline": "bun scripts/audit-codex-request-shapes.ts --install-baseline",
    "test:ci:workspaces": "node node_modules/turbo/bin/turbo run test --filter=!t3 --concurrency=2 --continue=always"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron-builder": "26.15.3",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.9.5",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "^8.0.0"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.3.9"
}
