{
  "$schema": "https://v2-9-5.turborepo.dev/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "T3CODE_LOG_WS_EVENTS",
    "T3CODE_LOG_THREAD_OPEN_TIMINGS",
    "T3CODE_LOG_PROJECTION_TIMINGS",
    "T3CODE_OBSERVABILITY_ENABLED",
    "T3CODE_TELEMETRY_ENABLED",
    "T3CODE_POSTHOG_KEY",
    "T3CODE_POSTHOG_HOST",
    "F5_HOME",
    "F5_COALESCE_STREAMING_DELTAS",
    "F5_STATE_DIR",
    "F5_PROFILE",
    "F5_GITHUB_OAUTH_CLIENT_ID",
    "F5_PORT_OFFSET",
    "F5_DEV_INSTANCE",
    "F5_BACKUP_MAX_COMPRESSED_BYTES",
    "F5_BACKUP_MAX_DECOMPRESSED_BYTES",
    "F5_BACKUP_MAX_TEMPORARY_BYTES",
    "F5_BACKUP_MAX_EXPANSION_RATIO",
    "F5_BACKUP_MIN_FREE_BYTES",
    "F5_RELEASE_REPOSITORY",
    "T3CODE_MODE",
    "T3CODE_PORT",
    "T3CODE_NO_BROWSER",
    "T3CODE_HOME",
    "T3CODE_STATE_DIR",
    "T3CODE_PORT_OFFSET",
    "T3CODE_DEV_INSTANCE",
    "T3CODE_AUTH_TOKEN",
    "T3CODE_DESKTOP_WS_URL"
  ],
  "globalPassThroughEnv": [
    "F5_COMPUTER_CONTROL_DEV",
    "F5_COMPUTER_BACKGROUND_DEV",
    "PATH",
    "Path",
    "PATHEXT",
    "SystemRoot",
    "ComSpec",
    "USERPROFILE",
    "APPDATA",
    "LOCALAPPDATA",
    "ProgramFiles",
    "PNPM_HOME",
    "BUN_INSTALL",
    "VOLTA_HOME",
    "FNM_DIR",
    "NVM_HOME",
    "NVM_SYMLINK",
    "DISPLAY",
    "XAUTHORITY",
    "WAYLAND_DISPLAY",
    "XDG_RUNTIME_DIR"
  ],
  "tasks": {
    "build": {
      "passThroughEnv": ["NODE_OPTIONS"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", "dist-native/**"]
    },
    "dev": {
      "dependsOn": ["@t3tools/contracts#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "passThroughEnv": [
        "F5_TEST_MAX_WORKERS",
        "F5_TEST_LOGS",
        "VITEST_MAX_WORKERS",
        "F5_CI_REPORT_DIR",
        "F5_CI_SUITE_ID",
        "F5_CI_TEST_RETRY",
        "GITHUB_JOB",
        "GITHUB_RUN_ID",
        "GITHUB_RUN_ATTEMPT",
        "GITHUB_WORKSPACE"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
