---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL, REPOSITORY_URL } from "../lib/releases";

const providers = [
  { name: "Codex", note: "Bundled · ChatGPT or API key" },
  { name: "Claude Code", note: "Bundled · multi-account & presets" },
  { name: "Cursor", note: "ACP · account models & effort" },
  { name: "OpenCode", note: "Local or external server" },
  { name: "Grok", note: "ACP · xAI CLI integration" },
  { name: "Antigravity", note: "ACP · Google sign-in or Gemini key" },
  { name: "Muse Code", note: "MSP · Meta CLI & modes" },
  { name: "Pi", note: "Local RPC · thinking levels" },
  { name: "Custom ACP", note: "Bring any local ACP agent" },
];

const capabilities = [
  {
    title: "Multi-model workflows",
    body: "Chain different providers across planning, peer cross-review, merge, implementation, code review, investigations, and technical documents.",
  },
  {
    title: "Parallel Git worktrees",
    body: "Send one prompt to multiple models in isolated worktrees with built-in checkpoints, rewind, diff inspection, and automated cleanup.",
  },
  {
    title: "PR Hub across five forges",
    body: "Review and act on pull requests from GitHub, GitLab, Bitbucket, Azure DevOps, and Forgejo right beside your agent threads.",
  },
  {
    title: "Preview browser & computer use",
    body: "Built-in preview browser with isolated profiles, SnapShot inspection, and permission-gated browser and desktop automation.",
  },
  {
    title: "MCP servers, skills & memory",
    body: "Manage project and global MCP servers, reusable skills, runtime permission modes, and project defaults via checked-in f5.json.",
  },
  {
    title: "Local-first profiles & CLI",
    body: "Isolated profiles with per-profile SQLite state, token & cost tracking, remote web access, and the standalone f5 CLI.",
  },
];
---

<Layout>
  <section class="hero">
    <span class="eyebrow">Desktop · Web · Standalone CLI</span>
    <h1 class="tagline">
      One workspace for every coding agent.
    </h1>
    <p class="subtitle">
      Run Codex, Claude Code, Cursor, OpenCode, Grok, Antigravity, Muse Code, Pi, and custom ACP
      agents against your repositories—and chain them into multi-model workflows where every step
      runs on the provider and model you choose.
    </p>

    <div class="cta-row">
      <a id="download-btn" href={RELEASES_URL} class="hero-button">
        <svg class="hero-button-icon hero-button-icon--apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        <svg class="hero-button-icon hero-button-icon--windows" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
        <svg class="hero-button-icon hero-button-icon--linux" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 295" aria-hidden="true"><path fill="currentColor" d="M63.213 215.474c-11.387-16.346-13.591-69.606 12.947-102.39C89.292 97.383 92.69 86.455 93.7 71.67c.734-16.805-11.846-66.851 35.537-70.616 48.027-3.857 45.364 43.526 45.088 68.596-.183 21.12 15.52 33.15 26.355 49.68 19.927 30.303 18.274 82.461-3.765 110.745-27.916 35.354-51.791 20.018-67.678 21.304-29.752 1.745-30.762 17.54-66.024-35.905"/></svg>
        <span id="download-label">Download F5</span>
      </a>
      <a href="/download" class="secondary-button">All platforms &amp; CLI</a>
    </div>

    <div class="screenshot-frame">
      <img
        src="/screenshots/workflow.png"
        alt="F5 multi-model Feature workflow board showing competing authors, cross-reviews, and merged implementation plan"
        class="screenshot"
      />
    </div>
  </section>

  <section id="workflows" class="section">
    <div class="section-header">
      <h2>Built for real multi-model engineering</h2>
      <p>
        Triage running agents from Home, inspect rich diffs and command output in threads, and let
        specialized models review each other before a line ships.
      </p>
    </div>

    <div class="gallery">
      <figure class="gallery-card">
        <img
          src="/screenshots/home.png"
          alt="F5 Home triage queue showing threads waiting for a decision, ready for review, and running work"
          loading="lazy"
        />
        <figcaption>
          <strong>Home triage</strong> — see what needs approval, what finished, and what is running without hunting through tabs.
        </figcaption>
      </figure>
      <figure class="gallery-card">
        <img
          src="/screenshots/thread.png"
          alt="F5 chat thread with highlighted command output, file changes, and inline diff panel"
          loading="lazy"
        />
        <figcaption>
          <strong>Threads &amp; diffs</strong> — syntax-highlighted command output, checkpoints, terminals, next-turn queues, and side-by-side diffs.
        </figcaption>
      </figure>
    </div>

    <div class="capabilities-grid">
      {capabilities.map((item) => (
        <article class="capability-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="providers" class="section">
    <div class="section-header">
      <h2>Eight built-in providers plus custom ACP agents</h2>
      <p>
        Mix providers freely across threads and workflow slots, or add multiple accounts per
        provider with isolated homes and usage tracking.
      </p>
    </div>

    <div class="provider-grid">
      {providers.map((provider) => (
        <div class="provider-pill">
          <span class="provider-name">{provider.name}</span>
          <span class="provider-note">{provider.note}</span>
        </div>
      ))}
    </div>

    <div class="bottom-cta">
      <a href="/download" class="hero-button">Get F5</a>
      <a
        href={`${REPOSITORY_URL}/blob/main/docs/user/getting-started.md`}
        target="_blank"
        rel="noopener noreferrer"
        class="secondary-button"
      >
        Read Getting Started &#8599;
      </a>
    </div>
  </section>
</Layout>

<script>
  import {
    DOWNLOAD_AVAILABILITY,
    fetchLatestRelease,
    resolveDownload,
    type DownloadTarget,
  } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; target: DownloadTarget; label: string };

  /** Chromium's client hints report "arm" on Apple Silicon; other browsers cannot tell. */
  async function isAppleSilicon(): Promise<boolean> {
    const hints = (
      navigator as Navigator & {
        userAgentData?: {
          getHighEntropyValues(keys: string[]): Promise<{ architecture?: string }>;
        };
      }
    ).userAgentData;
    try {
      return (await hints?.getHighEntropyValues(["architecture"]))?.architecture === "arm";
    } catch {
      return false;
    }
  }

  async function detectPlatform(): Promise<Platform | null> {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", target: "win-x64", label: "Download for Windows" };
    if (/Mac/i.test(ua))
      return (await isAppleSilicon())
        ? { os: "mac", target: "mac-arm64", label: "Download macOS preview (Apple Silicon)" }
        : { os: "mac", target: "mac-x64", label: "macOS: see download options" };
    if (/Linux/i.test(ua))
      return { os: "linux", target: "linux-x64", label: "Download for Linux" };
    return null;
  }

  async function init() {
    const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");
    if (!btn || !label) return;

    const platform = await detectPlatform();
    if (!platform) return;

    document.documentElement.dataset.platform = platform.os;
    label.textContent = platform.label;

    const availability = DOWNLOAD_AVAILABILITY[platform.target];
    let release = null;
    if (availability.kind === "stable") {
      try {
        release = await fetchLatestRelease();
      } catch {
        // resolveDownload falls back to the releases page.
      }
    }
    const { href } = resolveDownload(platform.target, release);
    btn.href = href ?? "/download";
    if (href && href.includes("/releases/download/")) {
      btn.removeAttribute("target");
      btn.removeAttribute("rel");
    }
  }

  init();
</script>

<style>
  .hero {
    width: 100%;
    max-width: 1120px;
    padding: 4.5rem 1.5rem 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    background: var(--card);
    border: 1px solid var(--border);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .tagline {
    font-weight: 600;
    font-size: clamp(2.15rem, 5vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    max-width: 18ch;
    margin-bottom: 1.25rem;
    animation: fade-in 0.55s ease-out both;
  }

  .subtitle {
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin-bottom: 2rem;
    animation: fade-in 0.55s ease-out 0.08s both;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    animation: fade-in 0.55s ease-out 0.14s both;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--primary);
    color: var(--primary-fg);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .hero-button:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .secondary-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--card);
    color: var(--fg);
    border: 1px solid var(--border);
    padding: 0.75rem 1.35rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: 0.9rem;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .secondary-button:hover {
    background: var(--card-hover);
    border-color: var(--border-strong);
  }

  .hero-button-icon {
    display: none;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  :global([data-platform="mac"]) .hero-button-icon--apple,
  :global([data-platform="win"]) .hero-button-icon--windows,
  :global([data-platform="linux"]) .hero-button-icon--linux {
    display: block;
  }

  .screenshot-frame {
    width: 100%;
    background: var(--bg);
    padding: 0.5rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    box-shadow: 0 24px 64px oklch(0 0 0 / 0.45);
    animation: fade-in 0.65s ease-out 0.2s both;
  }

  .screenshot {
    width: 100%;
    border-radius: calc(var(--radius-xl) - 0.3rem);
  }

  .section {
    width: 100%;
    max-width: 1120px;
    padding: 3.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-header {
    max-width: 64ch;
  }

  .section-header h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 0.6rem;
  }

  .section-header p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gallery-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .gallery-card img {
    width: 100%;
    border-bottom: 1px solid var(--border);
  }

  .gallery-card figcaption {
    padding: 0.9rem 1.1rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .gallery-card figcaption strong {
    color: var(--fg);
    font-weight: 600;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .capability-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .capability-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .capability-card p {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .provider-pill {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .provider-name {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .provider-note {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }

  .bottom-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .capabilities-grid,
    .provider-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 1rem 2rem;
    }

    .section {
      padding: 2.5rem 1rem;
    }

    .gallery,
    .capabilities-grid,
    .provider-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
