---
import Layout from "../layouts/Layout.astro";
import {
  DOWNLOAD_AVAILABILITY,
  RELEASES_URL,
  REPOSITORY_URL,
  resolveDownload,
  type DownloadTarget,
} from "../lib/releases";

// Rendered without the release fetch so the preview link and platform statuses
// work without JavaScript; the client script then links the latest stable installers.
const initial = Object.fromEntries(
  (Object.keys(DOWNLOAD_AVAILABILITY) as DownloadTarget[]).map((target) => [
    target,
    resolveDownload(target, null),
  ]),
) as Record<DownloadTarget, ReturnType<typeof resolveDownload>>;
const card = (target: DownloadTarget) => ({
  "data-target": target,
  href: initial[target].href ?? undefined,
  "aria-disabled": initial[target].href ? undefined : ("true" as const),
  class: initial[target].href ? "download-card" : "download-card download-card--unavailable",
});
---

<Layout title="Download | F5" description="Download F5 for Windows, Linux, and macOS, or run the standalone CLI.">
  <div class="download-page">
    <h1 class="heading">Download F5</h1>
    <p class="subheading">
      <span id="version-label">Loading latest release&hellip;</span>
      <a id="changelog-link" class="changelog-link" href="#" target="_blank" rel="noopener noreferrer" style="display:none">View changelog<span aria-hidden="true"> &#8599;</span></a>
    </p>

    <div class="platforms" id="platforms">
      <section class="platform-section">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
          <h2 class="platform-name">Windows</h2>
        </div>
        <div class="download-cards">
          <a {...card("win-x64")}>
            <span class="card-arch">Windows 10, 11 (x64)</span>
            <span class="card-format">.exe · unsigned</span>
            <span class="card-status">{initial["win-x64"].note}</span>
          </a>
        </div>
      </section>

      <section class="platform-section">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 295" aria-hidden="true"><path fill="currentColor" d="M63.213 215.474c-11.387-16.346-13.591-69.606 12.947-102.39C89.292 97.383 92.69 86.455 93.7 71.67c.734-16.805-11.846-66.851 35.537-70.616 48.027-3.857 45.364 43.526 45.088 68.596-.183 21.12 15.52 33.15 26.355 49.68 19.927 30.303 18.274 82.461-3.765 110.745-27.916 35.354-51.791 20.018-67.678 21.304-29.752 1.745-30.762 17.54-66.024-35.905"/></svg>
          <h2 class="platform-name">Linux</h2>
        </div>
        <div class="download-cards">
          <a {...card("linux-x64")}>
            <span class="card-arch">x86_64</span>
            <span class="card-format">AppImage</span>
            <span class="card-status">{initial["linux-x64"].note}</span>
          </a>
          <a {...card("linux-deb-x64")}>
            <span class="card-arch">Debian, Ubuntu (x86_64)</span>
            <span class="card-format">.deb</span>
            <span class="card-status">{initial["linux-deb-x64"].note}</span>
          </a>
        </div>
      </section>

      <section class="platform-section">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <h2 class="platform-name">macOS</h2>
        </div>
        <div class="download-cards">
          <a {...card("mac-arm64")}>
            <span class="card-arch">Apple Silicon (arm64)</span>
            <span class="card-format">.dmg</span>
            <span class="card-status">{initial["mac-arm64"].note}</span>
          </a>
          <a {...card("mac-x64")}>
            <span class="card-arch">Intel (x64)</span>
            <span class="card-format">.dmg</span>
            <span class="card-status">{initial["mac-x64"].note}</span>
          </a>
        </div>
      </section>

      <section class="platform-section">
        <div class="platform-header">
          <h2 class="platform-name">Standalone CLI</h2>
        </div>
        <p class="cli-note">
          Run F5 as a headless or browser-served server on macOS, Linux, or Windows using the
          <code>f5</code> CLI archives on the releases page. See
          <a href={`${REPOSITORY_URL}/blob/main/docs/user/standalone-cli.md`} target="_blank" rel="noopener noreferrer">
            Standalone CLI docs<span aria-hidden="true"> &#8599;</span>
          </a>.
        </p>
      </section>
    </div>

    <p class="releases-link">
      The Windows installer is not code-signed yet; SmartScreen may warn and Smart App Control blocks it. See the
      <a href={`${REPOSITORY_URL}/blob/main/docs/install.md#windows`} target="_blank" rel="noopener noreferrer">
        installation notes<span aria-hidden="true"> &#8599;</span>
      </a>.
    </p>

    <p class="releases-link">
      Looking for older versions or CLI archives? Check the
      <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
        GitHub releases page<span aria-hidden="true"> &#8599;</span>
      </a>.
    </p>
  </div>
</Layout>

<script>
  import {
    DOWNLOAD_AVAILABILITY,
    fetchLatestRelease,
    resolveDownload,
    type DownloadTarget,
    type Release,
  } from "../lib/releases";

  function renderCards(release: Release | null) {
    document.querySelectorAll<HTMLAnchorElement>(".download-card").forEach((card) => {
      const target = card.dataset.target as DownloadTarget | undefined;
      if (!target || !(target in DOWNLOAD_AVAILABILITY)) return;
      const { href, note } = resolveDownload(target, release);
      const status = card.querySelector(".card-status");
      if (status) status.textContent = note ?? "";
      if (href) {
        card.href = href;
        card.removeAttribute("aria-disabled");
        card.classList.remove("download-card--unavailable");
      } else {
        card.removeAttribute("href");
        card.setAttribute("aria-disabled", "true");
        card.classList.add("download-card--unavailable");
      }
    });
  }

  async function init() {
    const versionLabel = document.getElementById("version-label");

    try {
      const release = await fetchLatestRelease();

      if (versionLabel && release.tag_name) {
        versionLabel.textContent = `Latest (${release.tag_name})`;
      }

      const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement | null;
      if (changelogLink && release.html_url) {
        changelogLink.href = release.html_url;
        changelogLink.style.display = "";
      }

      renderCards(release);
    } catch {
      if (versionLabel) {
        versionLabel.textContent = "Could not load release info.";
      }
    }
  }

  init();
</script>

<style>
  .download-page {
    width: 100%;
    max-width: 760px;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .heading {
    font-weight: 600;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .subheading {
    font-size: 0.9rem;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .changelog-link {
    color: var(--fg-muted);
    font-size: 0.82rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .changelog-link:hover {
    color: var(--fg);
  }

  .platforms {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .platform-icon {
    width: 1.1em;
    height: 1.1em;
    color: var(--fg-muted);
    flex-shrink: 0;
  }

  .platform-name {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .download-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card);
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .download-card:hover {
    background: var(--card-hover);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .card-arch {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .card-format {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
  }

  .card-status {
    font-size: 0.76rem;
    color: var(--fg-muted);
  }

  .card-status:empty {
    display: none;
  }

  .download-card--unavailable {
    opacity: 0.55;
    cursor: default;
  }

  .download-card--unavailable:hover {
    background: var(--card);
    border-color: var(--border);
    transform: none;
  }

  .cli-note {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .cli-note a,
  .releases-link a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .releases-link {
    margin-top: 2rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--fg-muted);
    text-align: center;
  }

  @media (max-width: 640px) {
    .download-page {
      padding: 2.5rem 1rem;
    }

    .download-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
