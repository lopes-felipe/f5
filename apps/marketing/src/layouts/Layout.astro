---
import { REPOSITORY_URL } from "../lib/releases";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "F5 — Multi-model workspace for coding agents",
  description = "A desktop and web workspace for coding agents where each step of a workflow can run on a different provider and model.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header class="nav-wrap">
        <nav class="nav" aria-label="Primary">
          <a href="/" class="nav-brand">
            <img src="/icon.png" alt="" class="nav-icon" aria-hidden="true" />
            <span class="nav-name">F5</span>
          </a>
          <div class="nav-links">
            <a href="/#workflows" class="nav-link">Workflows</a>
            <a href="/#providers" class="nav-link">Providers</a>
            <a href="/download" class="nav-link">Download</a>
            <a
              href={`${REPOSITORY_URL}/blob/main/docs/README.md`}
              target="_blank"
              rel="noopener noreferrer"
              class="nav-link"
            >
              Docs
            </a>
            <a
              href={REPOSITORY_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="nav-github"
            >
              GitHub
              <span class="nav-github-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </nav>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <span class="footer-copy">&copy; {new Date().getFullYear()} F5 · MIT License</span>
        <div class="footer-links">
          <a href="/download">Download</a>
          <a href={`${REPOSITORY_URL}/blob/main/docs/README.md`} target="_blank" rel="noopener noreferrer">Docs</a>
          <a href={REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://discord.gg/jn4EGJjrvv" target="_blank" rel="noopener noreferrer">Discord</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --chrome: oklch(0.155 0.006 260);
    --bg: oklch(0.192 0.006 260);
    --card: oklch(0.222 0.007 260);
    --card-hover: oklch(0.25 0.008 260);
    --fg: oklch(0.95 0.003 260);
    --fg-muted: oklch(0.72 0.01 260);
    --fg-dim: oklch(0.58 0.01 260);
    --border: oklch(0.295 0.008 260);
    --border-strong: oklch(0.37 0.01 260);
    --primary: oklch(0.56 0.2 262);
    --primary-hover: oklch(0.62 0.2 262);
    --primary-fg: oklch(0.99 0 0);
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", "SF Mono", "SFMono-Regular", Consolas, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    background: radial-gradient(
      ellipse 80% 50% at 50% -10%,
      oklch(0.32 0.08 262 / 0.28),
      transparent 70%
    ),
      var(--chrome);
    color: var(--fg);
    font-family: var(--font-sans);
    font-feature-settings: "cv11", "ss01", "ss03";
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  code {
    font-family: var(--font-mono);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  .nav-wrap {
    width: 100%;
    border-bottom: 1px solid oklch(0.295 0.008 260 / 0.6);
    background: oklch(0.155 0.006 260 / 0.8);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .nav {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.5rem;
    gap: 1rem;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 0.95rem;
  }

  .nav-icon {
    width: 26px;
    height: 26px;
    border-radius: 6px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link,
  .nav-github {
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.18s ease;
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link:hover,
  .nav-github:hover {
    color: var(--fg);
  }

  .nav-github-arrow {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .nav-github:hover .nav-github-arrow {
    transform: translate(2px, -1px);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .footer {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 1.5rem;
    border-top: 1px solid oklch(0.295 0.008 260 / 0.6);
    font-size: 0.8rem;
    color: var(--fg-dim);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .nav {
      padding: 0.85rem 1rem;
    }

    .nav-links {
      gap: 0.85rem;
    }

    .nav-link:nth-child(1),
    .nav-link:nth-child(2) {
      display: none;
    }

    .footer {
      padding: 1.5rem 1rem;
    }
  }
</style>
