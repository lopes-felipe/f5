{
  "name": "t3",
  "version": "0.0.10",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun scripts/cli.ts build",
    "start": "node dist/index.mjs",
    "prepare": "node node_modules/@effect/language-service/cli.js patch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "bun run test:unit && bun run test:git:smoke && bun run test:integration",
    "test:full": "bun run test && bun run test:git:extended",
    "test:unit": "node node_modules/vitest/vitest.mjs run src",
    "test:git": "bun run test:git:smoke && bun run test:git:extended",
    "test:git:smoke": "node node_modules/vitest/vitest.mjs run integration/git/smoke",
    "test:git:extended": "node node_modules/vitest/vitest.mjs run integration/git/extended --sequence.concurrent --maxConcurrency=4",
    "test:git-core": "node node_modules/vitest/vitest.mjs run integration/git/extended/GitCore.extended.test.ts --no-file-parallelism",
    "test:git-manager": "node node_modules/vitest/vitest.mjs run integration/git/extended/GitManager.extended.test.ts --no-file-parallelism",
    "test:integration": "node node_modules/vitest/vitest.mjs run integration --exclude 'integration/git/**' --testTimeout=60000",
    "test:file": "node node_modules/vitest/vitest.mjs run",
    "test:claude:live": "F5_CLAUDE_LIVE_TEST=1 node node_modules/vitest/vitest.mjs run integration/claudeRuntime.live.test.ts --no-file-parallelism",
    "test:unit:shard": "node node_modules/vitest/vitest.mjs run src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "^1.1.0-beta.16",
    "cross-spawn": "7.0.6",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "effect-acp": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
