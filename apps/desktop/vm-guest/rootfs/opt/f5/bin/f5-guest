#!/usr/bin/python3
"""F5 guest tool. Root-owned and baked into the guest image; Lima's admin user runs it
through sudo. The non-sudo `f5` user, which runs the backend and everything it starts,
can't run it or change it.

  f5-guest status
      Prints one line of readiness JSON. Exit 0 only when the guest may run a backend.
  f5-guest install <version> <sha256> <archive>
      Verifies a linux-arm64 F5 CLI archive and installs it, root-owned, on the data disk.
  f5-guest launch <incarnation> <version>
      Main writes one line of boot JSON to stdin, then backend frames. Starts the backend
      as `f5` in a transient systemd scope, relays frames between this process's stdio and
      the backend's fds 3 (in) and 4 (out), and stops the whole scope when stdin closes.

Every command refuses to run anything when a check fails (exit 78).
"""
import hashlib
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import threading

DATA = "/var/lib/f5"
DATA_DEVICE_MOUNT = "/mnt/lima-f5-data"
POLICY_SUMS = "/opt/f5/policy.sha256"
IMAGE_INFO = "/opt/f5/image.json"
BACKEND_ROOT = DATA + "/backend"
STATE_DIR = DATA + "/state"
HOME = DATA + "/home"
GUEST_USER = "f5"
KEEP_BACKENDS = 2
VERSION_PATTERN = r"[0-9A-Za-z][0-9A-Za-z.+-]{0,63}"


class Refusal(Exception):
    pass


def quiet(*command):
    return subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def ensure_data_disk():
    """The persistent data disk holds all state. Without it, nothing runs."""
    if quiet("mountpoint", "-q", DATA) == 0:
        return
    if quiet("mountpoint", "-q", DATA_DEVICE_MOUNT) != 0:
        raise Refusal("the data disk is not attached")
    os.makedirs(DATA, mode=0o755, exist_ok=True)
    if quiet("mount", "--bind", DATA_DEVICE_MOUNT, DATA) != 0:
        raise Refusal("could not mount the data disk")
    os.chmod(DATA, 0o755)


def guest_user():
    try:
        user = pwd.getpwnam(GUEST_USER)
    except KeyError:
        raise Refusal("the f5 user is missing")
    if user.pw_uid == 0 or user.pw_gid == 0:
        raise Refusal("the f5 user is privileged")
    # `sudo -l -U` lists what a user may run; f5 must have no entry at all.
    listing = subprocess.run(
        ["sudo", "-n", "-l", "-U", GUEST_USER], capture_output=True, text=True
    ).stdout
    if "may run the following" in listing:
        raise Refusal("the f5 user has sudo rights")
    return user


def check_policy():
    if quiet("sha256sum", "--quiet", "--strict", "-c", POLICY_SUMS) != 0:
        raise Refusal("guest policy files do not match the image")
    if quiet("nft", "list", "table", "inet", "f5_egress") != 0:
        raise Refusal("the egress policy is not loaded")
    return guest_user()


def root_owned(path):
    info = os.lstat(path)
    return info.st_uid == 0 and not info.st_mode & 0o022


def installed_versions():
    try:
        names = os.listdir(BACKEND_ROOT)
    except FileNotFoundError:
        return []
    return sorted(
        name
        for name in names
        if re.fullmatch(VERSION_PATTERN, name)
        and os.path.isfile(os.path.join(BACKEND_ROOT, name, ".installed"))
    )


def check_backend(version):
    if not re.fullmatch(VERSION_PATTERN, version):
        raise Refusal("invalid backend version")
    root = os.path.join(BACKEND_ROOT, version)
    executable = os.path.join(root, "f5")
    for path in (BACKEND_ROOT, root, executable, os.path.join(root, ".installed")):
        try:
            if not root_owned(path):
                raise Refusal("backend " + version + " is not root-owned")
        except FileNotFoundError:
            raise Refusal("backend " + version + " is not installed")
    return root, executable


def command_status(args):
    if args:
        raise Refusal("usage: f5-guest status")
    status = {"ready": False}
    try:
        with open(IMAGE_INFO) as handle:
            status["image"] = json.load(handle)
    except (OSError, ValueError):
        status["image"] = None
    try:
        ensure_data_disk()
        check_policy()
        status["backends"] = installed_versions()
        status["ready"] = True
    except Refusal as refusal:
        status["reason"] = str(refusal)
    print(json.dumps(status, sort_keys=True))
    return 0 if status["ready"] else 78


def safe_members(archive, top):
    for member in archive.getmembers():
        name = member.name
        if name.startswith("/") or ".." in name.split("/"):
            raise Refusal("archive entry escapes the install root: " + name)
        if name != top and not name.startswith(top + "/"):
            raise Refusal("archive entry outside " + top + ": " + name)
        # The CLI archive is built with dereferenced links: regular files and directories only.
        if not (member.isfile() or member.isdir()):
            raise Refusal("archive entry is not a regular file: " + name)
        yield member


def command_install(args):
    if len(args) != 3:
        raise Refusal("usage: f5-guest install <version> <sha256> <archive>")
    version, expected, archive_path = args
    if not re.fullmatch(VERSION_PATTERN, version):
        raise Refusal("invalid backend version")
    if not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise Refusal("invalid sha256")
    ensure_data_disk()
    check_policy()
    target = os.path.join(BACKEND_ROOT, version)
    os.makedirs(BACKEND_ROOT, mode=0o755, exist_ok=True)
    os.chown(BACKEND_ROOT, 0, 0)
    os.chmod(BACKEND_ROOT, 0o755)
    top = "f5-" + version + "-linux-arm64"
    os.umask(0o022)
    stage = tempfile.mkdtemp(prefix=".install-", dir=BACKEND_ROOT)
    try:
        # Hash and extract the same root-owned copy, so the uploaded file can't change
        # between verification and use.
        copy = os.path.join(stage, "archive.tar.gz")
        digest = hashlib.sha256()
        with open(archive_path, "rb") as source, open(copy, "wb") as sink:
            for chunk in iter(lambda: source.read(1 << 20), b""):
                digest.update(chunk)
                sink.write(chunk)
        if digest.hexdigest() != expected:
            raise Refusal("archive digest does not match")
        with tarfile.open(copy, "r:gz") as archive:
            archive.extractall(stage, members=list(safe_members(archive, top)), filter="data")
        extracted = os.path.join(stage, top)
        for directory, dirnames, filenames in os.walk(extracted):
            for name in dirnames + filenames:
                path = os.path.join(directory, name)
                os.lchown(path, 0, 0)
                os.chmod(path, os.lstat(path).st_mode & 0o755)
        os.chown(extracted, 0, 0)
        os.chmod(extracted, 0o755)
        with open(os.path.join(extracted, ".installed"), "w") as handle:
            handle.write(expected + "\n")
        if os.path.exists(target):
            shutil.rmtree(target)
        os.rename(extracted, target)
    finally:
        shutil.rmtree(stage, ignore_errors=True)
        try:
            os.unlink(archive_path)
        except OSError:
            pass
    # Keep the new version and the one before it, for a rollback to an older F5.
    others = [name for name in installed_versions() if name != version]
    for name in others[: max(0, len(others) - (KEEP_BACKENDS - 1))]:
        shutil.rmtree(os.path.join(BACKEND_ROOT, name), ignore_errors=True)
    print(json.dumps({"installed": version}))
    return 0


def read_boot_line():
    """Read exactly one line from fd 0 without buffering past it: the rest is frames."""
    data = bytearray()
    while True:
        byte = os.read(0, 1)
        if not byte:
            raise Refusal("stdin closed before the boot line")
        if byte == b"\n":
            break
        data += byte
        if len(data) > 4096:
            raise Refusal("boot line too long")
    try:
        boot = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Refusal("boot line is not JSON")
    if not isinstance(boot, dict) or set(boot) != {"port", "authToken", "profileId"}:
        raise Refusal("boot line has unexpected fields")
    port, token, profile_id = boot["port"], boot["authToken"], boot["profileId"]
    if not isinstance(port, int) or isinstance(port, bool) or not 1024 <= port <= 65535:
        raise Refusal("invalid port")
    if not isinstance(token, str) or not re.fullmatch(r"[A-Za-z0-9_-]{16,256}", token):
        raise Refusal("invalid auth token")
    if not isinstance(profile_id, str) or not re.fullmatch(r"[0-9a-f]{32}", profile_id):
        raise Refusal("invalid profile id")
    return port, token, profile_id


def command_launch(args):
    if len(args) != 2:
        raise Refusal("usage: f5-guest launch <incarnation> <version>")
    incarnation, version = args
    if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", incarnation):
        raise Refusal("invalid incarnation")
    port, token, profile_id = read_boot_line()
    ensure_data_disk()
    user = check_policy()
    _root, executable = check_backend(version)
    for path in (STATE_DIR, HOME):
        os.makedirs(path, mode=0o700, exist_ok=True)
        os.chown(path, user.pw_uid, user.pw_gid)

    unit = "f5-backend-" + incarnation
    env = {
        "HOME": HOME,
        "USER": GUEST_USER,
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "T3CODE_MODE": "desktop",
        "T3CODE_NO_BROWSER": "1",
        "T3CODE_HOST": "127.0.0.1",
        "T3CODE_PORT": str(port),
        "F5_STATE_DIR": STATE_DIR,
        "T3CODE_STATE_DIR": STATE_DIR,
        "F5_EXECUTION_ENVIRONMENT": "linux-vm-guest",
        "F5_DESKTOP_COMPUTER_HOST": "frames",
        "F5_DESKTOP_PROFILE_ID": profile_id,
        "F5_DESKTOP_BACKEND_INCARNATION": incarnation,
    }
    setenv = [arg for key, value in env.items() for arg in ("--setenv", key + "=" + value)]
    # A bare --setenv NAME copies the value from systemd-run's own environment, so the token
    # never appears in a command line.
    setenv.append("--setenv=T3CODE_AUTH_TOKEN")
    # fd 3 carries main's frames in, fd 4 the backend's frames out. The backend's stdout
    # joins stderr, so nothing it or its children print can corrupt the frame stream.
    shim = 'exec 3<&0 4>&1 0</dev/null 1>&2; exec "$@"'
    child = subprocess.Popen(
        [
            "systemd-run", "--scope", "--quiet", "--collect", "--unit=" + unit,
            "--uid=" + GUEST_USER, "--gid=" + GUEST_USER, *setenv,
            "--", "/bin/sh", "-c", shim, "f5-backend", executable,
        ],
        stdin=subprocess.PIPE,
        stdout=sys.stdout.fileno(),
        stderr=sys.stderr.fileno(),
        cwd=HOME,
        env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "T3CODE_AUTH_TOKEN": token},
    )

    def stop_scope():
        quiet("systemctl", "stop", unit + ".scope")

    def relay():
        try:
            while True:
                chunk = os.read(0, 65536)
                if not chunk:
                    break
                child.stdin.write(chunk)
                child.stdin.flush()
        except (OSError, ValueError):
            pass
        # Main closed the channel: end every process the backend owns.
        stop_scope()
        try:
            child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            pass
        os._exit(0)

    threading.Thread(target=relay, daemon=True).start()
    code = child.wait()
    stop_scope()
    return code if code >= 0 else 1


COMMANDS = {"status": command_status, "install": command_install, "launch": command_launch}


def main():
    if os.geteuid() != 0:
        sys.stderr.write("f5-guest: must run as root\n")
        return 78
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.stderr.write("f5-guest: usage: f5-guest status|install|launch ...\n")
        return 78
    try:
        return COMMANDS[sys.argv[1]](sys.argv[2:])
    except Refusal as refusal:
        sys.stderr.write("f5-guest: " + str(refusal) + "\n")
        return 78


if __name__ == "__main__":
    sys.exit(main())
