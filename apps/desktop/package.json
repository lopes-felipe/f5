{
  "name": "@t3tools/desktop",
  "version": "0.0.10",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run --parallel dev:bundle dev:electron",
    "dev:bundle": "node node_modules/tsdown/dist/run.mjs --config tsdown.config.mts --watch",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "node node_modules/tsdown/dist/run.mjs --config tsdown.config.mts",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "effect": "catalog:",
    "electron": "40.6.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.2"
  },
  "productName": "F5 (Alpha)"
}
