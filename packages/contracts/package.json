{
  "name": "@t3tools/contracts",
  "version": "0.0.10",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts",
      "require": "./dist/index.cjs"
    },
    "./providerInstance": {
      "types": "./src/providerInstance.ts",
      "import": "./src/providerInstance.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "node node_modules/tsdown/dist/run.mjs src/index.ts --format esm,cjs --dts --watch --clean",
    "build": "node node_modules/tsdown/dist/run.mjs src/index.ts --format esm,cjs --dts --clean",
    "prepare": "node node_modules/@effect/language-service/cli.js patch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
